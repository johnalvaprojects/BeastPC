@{
    ViewBag.Title = "Reset password";
    Layout = "~/Views/Shared/_BeastAuthLayout.cshtml";
}

<div class="auth-shell">
    <section class="auth-left">
        <a class="auth-brand" href="@Url.Action("Index", "Home")">BEASTPC</a>
        <a class="auth-back" href="@Url.Action("LoginPage", "Account")">&larr; Back to login</a>

        <div class="auth-box">
            <span class="auth-eyebrow">BEASTPC / RESET</span>
            <h1 class="auth-title">Set a new<br/>password.</h1>
            <p class="auth-sub">Pick something at least 6 characters, with a mix of letters and numbers.</p>

            <div class="flash" id="rp-flash"></div>

            <form id="rp-form" onsubmit="return false;">
                <div class="auth-row">
                    <label for="rp-pass">New password</label>
                    <input id="rp-pass" type="password" autocomplete="new-password" />
                </div>
                <div class="auth-row">
                    <label for="rp-pass2">Confirm new password</label>
                    <input id="rp-pass2" type="password" autocomplete="new-password" />
                </div>

                <button type="submit" class="auth-submit" id="rp-submit">Update password</button>
            </form>

            <div class="auth-divider">OR</div>
            <p class="auth-alt">
                Remembered your old one?
                <a href="@Url.Action("LoginPage", "Account")">Sign in</a>
            </p>
        </div>
    </section>

    <section class="auth-right">
        <video autoplay muted loop playsinline>
            <source src="@Url.Content("~/Content/video/navbar/BlackTopoDesktop.mp4")" type="video/mp4" />
        </video>
        <div class="auth-right-caption">
            <div class="brand">New start.</div>
            <div class="line">Secure your BeastPC account</div>
        </div>
    </section>
</div>

@section scripts {
<script>
    (function () {
        var form = document.getElementById('rp-form');
        var btn = document.getElementById('rp-submit');
        var flash = document.getElementById('rp-flash');
        var p1 = document.getElementById('rp-pass');
        var p2 = document.getElementById('rp-pass2');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            flash.classList.remove('show', 'success', 'error');
            if (p1.value.length < 6) {
                flash.textContent = 'Password must be at least 6 characters.';
                flash.classList.add('show', 'error'); return;
            }
            if (p1.value !== p2.value) {
                flash.textContent = 'Passwords do not match.';
                flash.classList.add('show', 'error'); return;
            }
            btn.disabled = true;
            btn.textContent = 'Saving...';
            setTimeout(function () {
                flash.textContent = 'Password updated. Redirecting to sign-in...';
                flash.classList.add('show', 'success');
                setTimeout(function () { window.location.href = '@Url.Action("LoginPage", "Account")'; }, 1000);
            }, 700);
        });
    })();
</script>
}
