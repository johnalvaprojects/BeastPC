@{
    ViewBag.Title = "Forgot password";
    Layout = "~/Views/Shared/_RegistrationLayout.cshtml";
}

<div class="flex min-h-screen">
    <div class="flex-1 bg-white relative overflow-y-auto flex flex-col justify-center min-h-screen px-8 lg:px-16 xl:px-24 py-8">
        <div class="absolute top-6 left-6 z-10">
            <a href="@Url.Action("LoginPage", "Account")" class="flex items-center text-gray-600 transition-colors z-10 link-hover-dark custom-font-body" title="Back to login">&#8592; Login</a>
        </div>

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2 custom-font-title">Forgot password</h1>
            <p class="text-gray-600 custom-font-subtitle">Enter the email tied to your BeastPC account. We&rsquo;ll send a link to reset your password.</p>
        </div>

        <form id="fp-form" class="space-y-6 max-w-md w-full" onsubmit="return false;" novalidate>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2 custom-font-label" for="fp-email">Email</label>
                <input id="fp-email" name="email" type="email" autocomplete="email" maxlength="254"
                       class="w-full px-4 py-3 border-2 border-black focus:outline-none transition-colors custom-font-body"
                       placeholder="you@example.com" />
            </div>
            <button type="submit" id="fp-submit" class="w-full bg-black text-white py-3 px-4 border-2 border-black font-medium hover:bg-white hover:text-black focus:outline-none transition-all custom-font-button">
                Send reset link
            </button>
            <p class="text-gray-600 custom-font-body">
                Remembered it?
                <a href="@Url.Action("LoginPage", "Account")" class="link-hover-dark underline">Sign in</a>
            </p>
        </form>

        <div id="fp-modal-overlay" class="bp-auth-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="fp-modal-title">
            <div class="bp-auth-modal" onclick="event.stopPropagation();">
                <div class="bp-auth-modal-kicker">BeastPC</div>
                <h2 id="fp-modal-title" class="bp-auth-modal-title custom-font-title">Notice</h2>
                <p id="fp-modal-body" class="bp-auth-modal-body custom-font-body"></p>
                <button type="button" id="fp-modal-ok" class="bp-auth-modal-ok custom-font-button">OK</button>
            </div>
        </div>
    </div>

    <div class="hidden lg:flex lg:flex-1 relative overflow-hidden bg-black">
        <video autoplay loop muted playsinline preload="auto" class="absolute inset-0 w-full h-full object-cover">
            <source src="@Url.Content("~/Content/video/ryzen vid.mp4")" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    </div>
</div>

@section scripts {
<script>
    (function () {
        var form = document.getElementById("fp-form");
        var btn = document.getElementById("fp-submit");
        var input = document.getElementById("fp-email");
        var overlay = document.getElementById("fp-modal-overlay");
        var body = document.getElementById("fp-modal-body");
        var titleEl = document.getElementById("fp-modal-title");
        var ok = document.getElementById("fp-modal-ok");
        var resetUrl = "@Url.Action("ResetPassword", "Account")";

        if (!form || !btn || !input || !overlay || !body || !titleEl || !ok) return;

        function showModal(title, message, onOk) {
            titleEl.textContent = title || "Notice";
            body.textContent = message;
            overlay.style.display = "flex";
            ok.onclick = function () {
                overlay.style.display = "none";
                if (typeof onOk === "function") onOk();
            };
        }

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) overlay.style.display = "none";
        });

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            var val = (input.value || "").trim();
            if (!val || val.indexOf("@@") === -1) {
                showModal("Check your email", "Please enter a valid email address.");
                return;
            }
            btn.disabled = true;
            var prev = btn.textContent;
            btn.textContent = "Sending...";
            setTimeout(function () {
                btn.textContent = prev;
                btn.disabled = false;
                showModal("Check your inbox", "We've sent a reset link to " + val + ".", function () {
                    window.location.href = resetUrl;
                });
            }, 700);
        });
    })();
</script>
}
