                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg></span>
                <span class="nav-label">Dashboard</span>
            </a>

            <div class="nav-section-label">Manage</div>
            <a class="nav-item" ng-class="{active: activeTab==='builds'}" href="#" ng-click="switchTab('builds'); $event.preventDefault();">
                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="14" height="10" rx="1.5"/><path d="M4 4V3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1"/><line x1="8" y1="7" x2="8" y2="11"/><line x1="6" y1="9" x2="10" y2="9"/></svg></span>
                <span class="nav-label">Builds</span>
            </a>
            <a class="nav-item" ng-class="{active: activeTab==='orders'}" href="#" ng-click="switchTab('orders'); $event.preventDefault();">
                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2h2l2 7h6l2-5H6"/><circle cx="7" cy="13" r="1"/><circle cx="12" cy="13" r="1"/></svg></span>
                <span class="nav-label">Orders</span>
            </a>
            <a class="nav-item" ng-class="{active: activeTab==='users'}" href="#" ng-click="switchTab('users'); $event.preventDefault();">
                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="5" r="3"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg></span>
                <span class="nav-label">Users</span>
            </a>

            <div class="nav-section-label">Site</div>
            <a class="nav-item" href="@Url.Action("Index", "Home", null, Request.Url != null ? Request.Url.Scheme : Uri.UriSchemeHttps)">
                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8L8 2l6 6"/><path d="M4 6v7h3v-4h2v4h3V6"/></svg></span>
                <span class="nav-label">Homepage</span>
            </a>
            <a class="nav-item" href="@Url.Action("Shop", "Home", null, Request.Url != null ? Request.Url.Scheme : Uri.UriSchemeHttps)">
                <span class="nav-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="14" height="10" rx="1.5"/><line x1="5" y1="8" x2="11" y2="8"/><line x1="8" y1="5" x2="8" y2="11"/></svg></span>
                <span class="nav-label">Store</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-avatar" id="sidebarAvatar">—</div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name" id="sidebarName">Admin</div>
                <div class="sidebar-user-role">Administrator</div>
            </div>
        </div>
    </aside>

    @* ===== COLLAPSE TOGGLE ===== *@
    <button class="sidebar-toggle" id="sidebarToggle" title="Toggle sidebar">
        <svg viewBox="0 0 16 16"><polyline points="10,4 6,8 10,12"/></svg>
    </button>

    @* ===== MAIN ===== *@
    <div class="dash-main">

        @* ===== TOP BAR ===== *@
        <header class="topbar">
            <div class="topbar-left">
                <span class="topbar-eyebrow">BEASTPC / ADMIN</span>
                <span class="topbar-title" id="topbarTitle">Dashboard</span>
            </div>
            <div class="topbar-right">
                <span class="topbar-clock" id="topbarClock">00:00:00</span>
                <span class="topbar-badge">Administrator</span>
                <button class="topbar-logout" id="logoutBtn">Log out</button>
            </div>
        </header>

        @* ===== PAGE CONTENT ===== *@
        <div class="dash-content">

            @* ===== CARDS (dynamic) ===== *@
            <div class="stat-row">
                <div class="stat-card"
                     ng-repeat="c in cardData track by $index"
                     ng-style="{'--accent': c.Accent || 'rgba(255,255,255,0.12)'}">
                    <div class="stat-label">{{c.Title}}</div>
                    <div class="stat-value">{{c.Value}}</div>
                    <div class="stat-sub">{{c.Subtitle}}</div>
                </div>
            </div>

            @* ===== CHART (dynamic) ===== *@
            <div style="display:grid;grid-template-columns: 1fr; gap: 1rem; margin-bottom: 1.8rem;">
                <div class="stat-card order-status-chart-card" style="--accent: rgba(255,255,255,0.12)">
                    <div class="stat-label" style="margin-bottom:0.85rem;">Orders by status</div>
                    <div class="order-chart-canvas-wrap">
                        <canvas ng-show="!chartPlaceholder" class="chart chart-horizontal-bar"
                                chart-data="orderStatusData"
                                chart-labels="orderStatusLabels"
                                chart-colors="orderStatusColors"
                                chart-options="orderStatusOptions"></canvas>
                        <div ng-show="chartPlaceholder" class="order-chart-placeholder">
                            No orders yet — chart will populate when orders exist
                        </div>
                    </div>
                    <div class="stat-sub order-chart-caption">Counts by status · hover a bar for totals and share</div>
                </div>
            </div>

            @* ===== TABS ===== *@
            <div class="tab-row" id="tabRow">
                <button class="tab-btn" ng-class="{active: activeTab==='overview'}" ng-click="switchTab('overview')">Overview</button>
                <button class="tab-btn" ng-class="{active: activeTab==='builds'}" ng-click="switchTab('builds')">Builds</button>
                <button class="tab-btn" ng-class="{active: activeTab==='orders'}" ng-click="switchTab('orders')">Orders</button>
                <button class="tab-btn" ng-class="{active: activeTab==='users'}" ng-click="switchTab('users')">Users</button>
            </div>

            @* OVERVIEW panel *@
            <div class="tab-panel" id="panel-overview" ng-class="{active: activeTab==='overview'}">
                <div class="data-header">
                    <span class="data-title">Dashboard cards</span>
                    <button class="action-btn primary" type="button" ng-click="openNewDashboardCard()">+ Add card</button>
                </div>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.45);letter-spacing:0.08em;margin:0 0 1rem 0;">
                    Cards are stored in MySQL (<span style="color:rgba(255,255,255,0.65)">admin_dashboard_cards</span>) and values are computed on the server from live data.
                </p>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width:72px">Order</th>
                                <th>Title</th>
                                <th>Metric</th>
                                <th style="width:96px">Active</th>
                                <th style="width:220px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-if="!cardDefs.length" class="empty-row"><td colspan="5">No definitions found (defaults are created automatically on first dashboard load).</td></tr>
                            <tr ng-repeat="c in cardDefs track by c.Id">
                                <td style="color:rgba(255,255,255,0.35)">{{c.SortOrder}}</td>
                                <td>
                                    <div style="font-weight:600;letter-spacing:0.04em">{{c.Title}}</div>
                                    <div style="font-size:0.66rem;color:rgba(255,255,255,0.35);margin-top:0.15rem;">{{c.Subtitle}}</div>
                                </td>
                                <td style="color:rgba(255,255,255,0.55)">
                                    {{c.MetricKey}}
                                    <span ng-if="c.MetricKey==='literal'"> — {{c.LiteralValue}}</span>
                                </td>
                                <td><span class="badge" ng-class="c.IsActive ? 'badge-active' : 'badge-inactive'">{{c.IsActive ? 'Yes' : 'No'}}</span></td>
                                <td>
                                    <div class="table-actions">
                                        <button class="action-btn" type="button" ng-click="editDashboardCard(c)">Edit</button>
                                        <button class="action-btn danger" type="button" ng-click="deleteDashboardCardDef(c)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @* BUILDS panel *@
            <div class="tab-panel" id="panel-builds" ng-class="{active: activeTab==='builds'}">
                <div class="data-header">
                    <span class="data-title">PC Builds</span>
                    <div style="display:flex;gap:0.5rem;align-items:center;">
                        <input class="data-search" type="text" placeholder="Search builds..." ng-model="searchBuilds" />
                        <button class="action-btn primary" ng-click="openAddModal()">+ Add build</button>
                    </div>
                </div>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width:48px"></th>
                                <th>Name</th>
                                <th>CPU</th>
                                <th>GPU</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="builds-tbody">
                            <tr ng-if="(builds | filter:searchBuilds).length===0" class="empty-row"><td colspan="8">No builds found.</td></tr>
                            <tr ng-repeat="b in builds | filter:searchBuilds track by b.Id">
                                <td>
                                    <div class="build-thumb" ng-style="b.ImageUrl ? {'background-image':'url('+b.ImageUrl+')'} : {}">
                                        <svg ng-if="!b.ImageUrl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight:600;letter-spacing:0.04em">{{b.Name}}</div>
                                    <div style="font-size:0.66rem;color:rgba(255,255,255,0.35);margin-top:0.15rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{b.Description || '—'}}</div>
                                </td>
                                <td style="color:rgba(255,255,255,0.55)">{{b.Cpu || '—'}}</td>
                                <td style="color:rgba(255,255,255,0.55)">{{b.Gpu || '—'}}</td>
                                <td style="font-weight:500">{{peso(b.Price)}}</td>
                                <td style="color:rgba(255,255,255,0.6)">{{b.Stock}}</td>
                                <td>
                                    <span class="badge" ng-class="b.Active ? 'badge-active' : 'badge-inactive'">{{b.Active ? 'Active' : 'Inactive'}}</span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button class="action-btn" ng-click="openEditModal(b)">Edit</button>
                                        <button class="action-btn danger" ng-click="deleteFunc(b.Id)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @* ORDERS panel *@
            <div class="tab-panel" id="panel-orders" ng-class="{active: activeTab==='orders'}">
                <div class="data-header">
                    <span class="data-title">Orders</span>
                    <input class="data-search" type="text" placeholder="Search orders..." ng-model="searchOrders" />
                </div>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>User</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th style="width:120px;text-align:right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody">
                            <tr ng-if="(orders | filter:searchOrders).length===0" class="empty-row"><td colspan="6">No orders yet.</td></tr>
                            <tr ng-repeat="o in orders | filter:searchOrders track by o.Id">
                                <td style="font-family:Bebas Neue,sans-serif;letter-spacing:0.05em">BP-{{o.Id}}</td>
                                <td>User #{{o.UserId}}</td>
                                <td>{{peso(o.TotalAmount)}}</td>
                                <td>
                                    <select class="order-status-select"
                                            ng-model="orderStatusDraft[o.Id]"
                                            ng-options="opt.value as opt.label for opt in orderStatusSelectOptions"></select>
                                </td>
                                <td style="color:rgba(255,255,255,0.4)">{{toDate(o.CreatedAt)}}</td>
                                <td style="text-align:right">
                                    <button type="button"
                                            class="action-btn primary"
                                            ng-disabled="!orderStatusDirty(o)"
                                            ng-click="applyOrderStatus(o)">Save</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @* USERS panel *@
            <div class="tab-panel" id="panel-users" ng-class="{active: activeTab==='users'}">
                <div class="data-header">
                    <span class="data-title">Registered Users</span>
                    <input class="data-search" type="text" placeholder="Search users..." ng-model="searchUsers" />
                </div>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="users-tbody">
                            <tr ng-if="(users | filter:searchUsers).length===0" class="empty-row"><td colspan="7">No users found.</td></tr>
                            <tr ng-repeat="u in users | filter:searchUsers track by u.Id">
                                <td style="color:rgba(255,255,255,0.35)">{{$index + 1}}</td>
                                <td>{{u.FirstName}} {{u.LastName}}</td>
                                <td>&#64;{{u.Username}}</td>
                                <td style="color:rgba(255,255,255,0.55)">{{u.Email}}</td>
                                <td>
                                    <span class="badge" ng-class="u.Role==='admin' ? 'badge-admin' : 'badge-user'">{{u.Role}}</span>
                                </td>
                                <td style="color:rgba(255,255,255,0.4)">{{toDate(u.CreatedAt)}}</td>
                                <td>
                                    <div class="table-actions">
                                        <button class="action-btn" ng-click="toggleRole(u)">Change role</button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>@* /dash-content *@

        @* ===== ADD/EDIT BUILD MODAL (must live inside ng-controller scope) ===== *@
        <div class="modal-bg" id="buildModal" ng-class="{open: buildModalOpen}" ng-click="closeModalOnBg($event)">
            <div class="modal" ng-click="$event.stopPropagation()">

                <div class="modal-header">
                    <div class="modal-header-text">
                        <div class="modal-eyebrow">{{buildForm.Id ? 'Editing build #' + buildForm.Id : 'New listing'}}</div>
                        <p class="modal-title">{{buildForm.Id ? 'Edit build' : 'Add build'}}</p>
                    </div>
                    <button class="modal-close" ng-click="closeModal()">&times;</button>
                </div>

                <div class="modal-body">

                    @* Left — image preview *@
                    <div class="modal-image-col">
                        <div class="image-preview-box" id="imgPreviewBox">
                            <div class="image-preview-placeholder">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                <span>No image</span>
                            </div>
                            <img id="imgPreviewEl" src="" alt="preview" />
                        </div>
                        <div class="form-row" style="margin-bottom:0">
                            <label>Upload image</label>
                            <input type="file" accept="image/*" onchange="angular.element(this).scope().onImageFileChange(this)" />
                        </div>
                        <div ng-if="isUploadingImage" style="font-size:0.6rem;color:rgba(255,255,255,0.35);letter-spacing:0.08em">
                            Uploading...
                        </div>
                        <div ng-if="uploadImageErr" style="font-size:0.62rem;color:#ff7070;letter-spacing:0.04em;line-height:1.4">
                            {{uploadImageErr}}
                        </div>
                        <div class="form-row" style="margin-bottom:0">
                            <label>Image URL</label>
                            <input type="text" placeholder="https://..." ng-model="buildForm.ImageUrl" ng-change="previewImage()" />
                        </div>
                        <p style="font-size:0.58rem;color:rgba(255,255,255,0.22);letter-spacing:0.06em;line-height:1.5">
                            Paste a direct image link (JPG / PNG / WebP). Paste to preview.
                        </p>
                        <div class="form-row" style="margin-bottom:0">
                            <label>Status</label>
                            <select ng-model="buildForm.Active">
                                <option ng-value="true">Active</option>
                                <option ng-value="false">Inactive</option>
                            </select>
                        </div>
                    </div>

                    @* Right — fields *@
                    <div class="modal-fields-col">
                        <div class="form-section-label">Basic info</div>
                        <div class="form-row"><label>Build name *</label><input type="text" placeholder="e.g. BEAST RANGER X" ng-model="buildForm.Name" /></div>
                        <div class="form-row"><label>Description</label><textarea placeholder="Short description of the build..." ng-model="buildForm.Description"></textarea></div>
                        <div class="form-row cols-2">
                            <div class="form-row"><label>Price (PHP) *</label><input type="number" placeholder="0" ng-model="buildForm.Price" /></div>
                            <div class="form-row"><label>Stock</label><input type="number" placeholder="0" ng-model="buildForm.Stock" /></div>
                        </div>

                        <div class="form-section-label">Specs</div>
                        <div class="form-row cols-2">
                            <div class="form-row"><label>CPU</label><input type="text" placeholder="e.g. Intel i9-14900K" ng-model="buildForm.Cpu" /></div>
                            <div class="form-row"><label>GPU</label><input type="text" placeholder="e.g. RTX 4090" ng-model="buildForm.Gpu" /></div>
                        </div>
                        <div class="form-row cols-2">
                            <div class="form-row"><label>RAM</label><input type="text" placeholder="e.g. 32GB DDR5" ng-model="buildForm.Ram" /></div>
                            <div class="form-row"><label>Storage</label><input type="text" placeholder="e.g. 2TB NVMe SSD" ng-model="buildForm.Storage" /></div>
                        </div>
                        <div class="form-row cols-2">
                            <div class="form-row"><label>Cooling</label><input type="text" placeholder="e.g. AIO 360mm" ng-model="buildForm.Cooling" /></div>
                            <div class="form-row"><label>PSU</label><input type="text" placeholder="e.g. 850W Gold" ng-model="buildForm.Psu" /></div>
                        </div>
                        <div class="form-row">
                            <label>Case</label>
                            <input type="text" placeholder="e.g. NZXT H7 Flow" ng-model="buildForm.CaseName" />
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="action-btn" ng-click="closeModal()">Cancel</button>
                    <button class="action-btn" ng-click="clearFunc()">Clear</button>
                    <button class="action-btn primary" ng-click="buildForm.Id ? updateFunc() : addFunc()">
                        {{buildForm.Id ? 'Save changes' : 'Add build'}}
                    </button>
                </div>

            </div>
        </div>

        @* ===== DASHBOARD CARD EDITOR ===== *@
        <div class="modal-bg" id="cardModal" ng-class="{open: cardModalOpen}" ng-click="closeDashboardCardModal()">
            <div class="modal" ng-click="$event.stopPropagation()" style="max-width:520px;">
                <div class="modal-header">
                    <div class="modal-header-text">
                        <div class="modal-eyebrow">Dashboard</div>
                        <p class="modal-title">{{cardEditor.Id ? 'Edit card' : 'Add card'}}</p>
                    </div>
                    <button type="button" class="modal-close" ng-click="closeDashboardCardModal()">&times;</button>
                </div>

                <div class="modal-body">
                    <div class="modal-fields-col" style="width:100%;">
                        <div class="form-row cols-2">
                            <div class="form-row">
                                <label>Sort order</label>
                                <input type="number" ng-model="cardEditor.SortOrder" />
                            </div>
                            <div class="form-row">
                                <label>Active</label>
                                <select ng-model="cardEditor.IsActive">
                                    <option ng-value="true">Yes</option>
                                    <option ng-value="false">No</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row"><label>Title *</label><input type="text" ng-model="cardEditor.Title" /></div>
                        <div class="form-row"><label>Subtitle</label><input type="text" ng-model="cardEditor.Subtitle" /></div>
                        <div class="form-row"><label>Accent (CSS rgba)</label><input type="text" ng-model="cardEditor.Accent" /></div>
                        <div class="form-row">
                            <label>Metric source</label>
                            <select ng-model="cardEditor.MetricKey">
                                <option value="builds">Total builds</option>
                                <option value="orders">Total orders</option>
                                <option value="users">Registered users</option>
                                <option value="revenue">Revenue (delivered)</option>
                                <option value="pending">Pending orders</option>
                                <option value="literal">Literal text</option>
                            </select>
                        </div>
                        <div class="form-row" ng-if="cardEditor.MetricKey==='literal'">
                            <label>Literal value</label>
                            <input type="text" ng-model="cardEditor.LiteralValue" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="action-btn" ng-click="closeDashboardCardModal()">Cancel</button>
                    <button type="button" class="action-btn primary" ng-click="saveDashboardCardDef()">Save</button>
                </div>
            </div>
        </div>

        @* ===== ADMIN CONFIRM (replaces native confirm) ===== *@
        <div class="admin-confirm-overlay"
             ng-class="{open: adminConfirm.open}"
             ng-click="onAdminConfirmBackdrop($event)"
             aria-hidden="{{!adminConfirm.open}}">
            <div class="admin-confirm-box" ng-click="$event.stopPropagation()" role="alertdialog">
                <div class="admin-confirm-kicker">{{adminConfirm.title}}</div>
                <p class="admin-confirm-msg">{{adminConfirm.message}}</p>
                <div class="admin-confirm-actions">
                    <button type="button" class="action-btn" ng-click="dismissAdminConfirm()">{{adminConfirm.cancelLabel}}</button>
                    <button type="button"
                            class="action-btn primary"
                            ng-class="{'confirm-destructive': adminConfirm.destructive}"
                            ng-click="acceptAdminConfirm()">{{adminConfirm.confirmLabel}}</button>
                </div>
            </div>
        </div>

    </div>@* /dash-main *@
</div>@* /dash-shell *@

@section scripts {
    <script src="/Scripts/angular.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/angular-chart.js@1.1.1/dist/angular-chart.min.js"></script>
    <script src="/Scripts/BeastPc/AdminModule.js"></script>
    <script src="/Scripts/BeastPc/AdminService.js"></script>
    <script src="/Scripts/BeastPc/AdminDashController.js"></script>
    <script>
        (function () {
            var shell = document.getElementById("dashShell");
            document.getElementById("sidebarToggle").addEventListener("click", function () {
                shell.classList.toggle("collapsed");
            });

            function tick() {
                var now = new Date();
                var pad = function (n) { return n < 10 ? "0" + n : n; };
                document.getElementById("topbarClock").textContent =
                    pad(now.getHours()) + ":" + pad(now.getMinutes()) + ":" + pad(now.getSeconds());
            }
            tick();
            setInterval(tick, 1000);

            try {
                var cur = JSON.parse(sessionStorage.getItem("CurrentUser") || "{}");
                var initials = ((cur.FirstName || "?")[0] + (cur.LastName || "?")[0]).toUpperCase();
                document.getElementById("sidebarAvatar").textContent = initials;
                document.getElementById("sidebarName").textContent = (cur.FirstName || "") + " " + (cur.LastName || "");
            } catch (e) { }

            document.getElementById("logoutBtn").addEventListener("click", function () {
                sessionStorage.removeItem("CurrentUser");
                window.location.href = "/Account/LoginPage";
            });
        })();
    </script>
}
