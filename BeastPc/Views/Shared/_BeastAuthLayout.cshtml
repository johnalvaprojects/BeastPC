@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BeastPc</title>
    <style>
        @@font-face {
            font-family: 'OrithDisplay';
            src: url('@Url.Content("~/Content/fonts/orith-font/orithdisplay-regular.otf")') format("opentype");
            font-weight: 400; font-style: normal; font-display: swap;
        }
        @@font-face {
            font-family: 'Inter Display';
            src: url('@Url.Content("~/Content/fonts/Inter-4.1/extras/otf/InterDisplay-Medium.otf")') format("opentype");
            font-weight: 500; font-style: normal; font-display: swap;
        }
        @@font-face {
            font-family: 'Bebas Neue';
            src: url('@Url.Content("~/Content/fonts/bebas_neue/BebasNeue-Regular.otf")') format("opentype");
            font-weight: 400; font-style: normal; font-display: swap;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            background: #000;
            color: #fff;
            font-family: 'Inter Display', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* Left (form) side */
        .auth-left {
            position: relative;
            padding: 4rem 4.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #000;
        }
        .auth-brand {
            position: absolute;
            top: 2.2rem;
            left: 4.5rem;
            font-family: 'OrithDisplay', cursive;
            font-size: 1.55rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #fff;
            text-decoration: none;
        }
        .auth-back {
            position: absolute;
            top: 2.4rem;
            right: 4.5rem;
            font-size: 0.64rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        .auth-back:hover { color: #fff; }

        .auth-box {
            max-width: 420px;
            width: 100%;
        }
        .auth-eyebrow {
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
        }
        .auth-title {
            font-family: 'OrithDisplay', cursive;
            font-size: clamp(3rem, 6vw, 4.5rem);
            letter-spacing: 0.06em;
            line-height: 0.9;
            margin: 0.4rem 0 0.8rem 0;
            text-transform: uppercase;
        }
        .auth-sub {
            font-size: 0.88rem;
            color: rgba(255,255,255,0.65);
            line-height: 1.5;
            margin-bottom: 2.4rem;
            max-width: 360px;
        }

        .auth-row { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
        .auth-row.cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
        .auth-row label {
            font-size: 0.62rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.55);
        }
        .auth-row input {
            background: #070707;
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            padding: 0.8rem 0.95rem;
            font-family: inherit;
            font-size: 0.84rem;
            letter-spacing: 0.02em;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.2s ease;
        }
        .auth-row input:focus { border-color: rgba(255,255,255,0.5); }

        .auth-inline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            color: rgba(255,255,255,0.55);
            margin: -0.2rem 0 1.6rem 0;
        }
        .auth-inline a { color: #fff; text-decoration: none; }
        .auth-inline a:hover { text-decoration: underline; text-underline-offset: 3px; }
        .auth-check {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            cursor: pointer;
        }
        .auth-check input { accent-color: #fff; }

        .auth-submit {
            width: 100%;
            padding: 1rem;
            background: #fff;
            color: #000;
            border: none;
            border-radius: 999px;
            cursor: pointer;
            font-family: inherit;
            font-size: 0.7rem;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            transition: transform 0.2s ease, background 0.2s ease;
        }
        .auth-submit:hover { background: rgba(255,255,255,0.88); transform: translateY(-1px); }
        .auth-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin: 1.6rem 0;
            font-size: 0.6rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
        }
        .auth-divider::before, .auth-divider::after {
            content: '';
            flex: 1 1 auto;
            height: 1px;
            background: rgba(255,255,255,0.08);
        }

        .auth-alt {
            font-size: 0.78rem;
            letter-spacing: 0.05em;
            color: rgba(255,255,255,0.55);
            text-align: center;
        }
        .auth-alt a { color: #fff; text-decoration: none; margin-left: 0.25rem; }
        .auth-alt a:hover { text-decoration: underline; text-underline-offset: 3px; }

        .flash {
            display: none;
            margin-bottom: 1rem;
            padding: 0.75rem 0.9rem;
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 6px;
            font-size: 0.72rem;
            letter-spacing: 0.04em;
            color: rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.03);
        }
        .flash.show { display: block; }
        .flash.success { border-color: rgba(120,255,180,0.35); color: #d7ffe7; }
        .flash.error   { border-color: rgba(255,120,120,0.35); color: #ffd7d7; }

        /* Right (visual) side */
        .auth-right {
            position: relative;
            overflow: hidden;
            background: #050505;
        }
        .auth-right video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.8;
        }
        .auth-right::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.65));
        }
        .auth-right-caption {
            position: absolute;
            left: 2.4rem;
            bottom: 2.4rem;
            z-index: 2;
            max-width: 360px;
        }
        .auth-right-caption .brand {
            font-family: 'OrithDisplay', cursive;
            font-size: 2.4rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            line-height: 0.95;
        }
        .auth-right-caption .line {
            font-size: 0.8rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.7);
            margin-top: 0.6rem;
        }

        /* Verify-code inputs */
        .code-inputs {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0.6rem;
            margin: 1rem 0 1.6rem 0;
        }
        .code-inputs input {
            padding: 1rem 0;
            text-align: center;
            font-family: 'Bebas Neue', system-ui, sans-serif;
            font-size: 1.6rem;
            letter-spacing: 0.05em;
            background: #070707;
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            border-radius: 8px;
            outline: none;
        }
        .code-inputs input:focus { border-color: rgba(255,255,255,0.5); }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    @RenderBody()
    @RenderSection("scripts", required: false)
</body>
</html>
