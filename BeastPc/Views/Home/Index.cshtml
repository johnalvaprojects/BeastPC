@section scripts {
<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
<script>
(function () {
    // Hero video rotation
    var urls = [
        '@Url.Content("~/Content/video/videohomepage/vid1.mp4")',
        '@Url.Content("~/Content/video/videohomepage/vid2.mp4")',
        '@Url.Content("~/Content/video/videohomepage/vid3.mp4")',
        '@Url.Content("~/Content/video/videohomepage/vid4.mp4")'
    ];
    var el = document.getElementById('js-hero-video');
    if (el && urls.length > 0) {
        var index = 0;
        function playNext() {
            el.src = urls[index];
            el.load();
            el.play().catch(function () { });
            index = (index + 1) % urls.length;
        }
        playNext();
        setInterval(playNext, 3000);
    }

    // Simple typewriter animation for hero lines
    (function runTypewriter() {
        var lines = Array.prototype.slice.call(document.querySelectorAll('.landing-hero-text .js-typer'));
        if (!lines.length) return;

        var currentLine = 0;
        var charIndex = 0;
        var typingSpeed = 45;      // ms per character
        var linePause = 350;       // pause between lines

        // Store full texts and clear visible content
        var texts = lines.map(function (el) {
            var full = (el.textContent || '').trim();
            el.textContent = '';
            return full;
        });

        function typeNextChar() {
            if (currentLine >= lines.length) return;

            var el = lines[currentLine];
            var full = texts[currentLine];

            el.textContent = full.slice(0, charIndex + 1);
            charIndex++;

            if (charIndex < full.length) {
                setTimeout(typeNextChar, typingSpeed);
            } else {
                // brief glitch flash when a line finishes
                if (el.classList.contains('hero-glitch')) {
                    el.setAttribute('data-text', full);
                    el.classList.add('glitch-active');
                    setTimeout(function () {
                        el.classList.remove('glitch-active');
                        el.textContent = full;
                        el.style.opacity = '1';
                    }, 200);
                }

                currentLine++;
                charIndex = 0;
                if (currentLine < lines.length) {
                    setTimeout(typeNextChar, linePause);
                } else {
                    // All lines typed — lock final copy + opacity (guards against CSS edge cases)
                    for (var j = 0; j < lines.length; j++) {
                        lines[j].textContent = texts[j];
                        lines[j].style.opacity = '1';
                    }
                }
            }
        }

        // small delay so video starts first
        setTimeout(typeNextChar, 400);
    })();

    // RGB per-letter setup for BEAST PC texts
    function setupRgbLetters(selector, baseDelay, step) {
        var nodes = document.querySelectorAll(selector);
        nodes.forEach(function (node) {
            if (!node || !node.textContent) return;
            var text = node.textContent;
            node.textContent = "";
            for (var i = 0; i < text.length; i++) {
                var ch = text[i];
                var span = document.createElement("span");
                span.className = "rgb-letter";
                span.textContent = (ch === " ") ? "\u00A0" : ch;
                span.style.animationDelay = (baseDelay + i * step) + "s";
                node.appendChild(span);
            }
        });
    }

    // Apply RGB letter animation to hero notch BEAST PC and section BEAST PC
    setupRgbLetters(".landing-title-in-notch span", 0.4, 0.18);
    setupRgbLetters(".project-title", 0.0, 0.22);

    // Scroll animations
    if (window.gsap && window.ScrollTrigger) {
        gsap.registerPlugin(ScrollTrigger);

        // Featured product: simple scroll-linked reveal
        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: ".project-outer",
                start: "top 80%",
                end: "bottom center",
                scrub: 0.7
            }
        });

        // Right video frame
        tl.from(".project-frame", {
            opacity: 0,
            y: 60,
            scale: 0.96,
            duration: 1.1,
            ease: "power3.out"
        }, 0);

        // Static labels on left (FEATURED PRODUCT / 01) - glide in from left
        tl.from([
            ".project-label",
            ".project-number"
        ], {
            opacity: 0,
            x: -40,
            y: 0,
            duration: 1.0,
            ease: "expo.out",
            stagger: 0.08
        }, 0.05);

        // Title, body and VIEW PRODUCT: stronger glide-in from the left (tied to main timeline scrub)
        tl.from([
            ".project-title",
            ".project-body",
            ".project-view-text"
        ], {
            opacity: 0,
            x: -40,
            y: 16,
            duration: 1.0,
            ease: "expo.out",
            stagger: 0.09
        }, 0.15);

        // (scramble text animation removed by design request)
    }

    // Hero nav "fake" page transition (Codrops-style crossfade)
    (function setupHeroNavTransition() {
        var trigger = document.querySelector(".landing-menu");
        var overlay = document.querySelector(".landing-transition-overlay");
        var frame = document.querySelector(".landing-frame");
        var closeBtn = document.querySelector(".landing-nav-close");
        if (!trigger || !overlay || !frame || !window.gsap) return;

        var isOpen = false;
        var busy = false;

        function openPanel() {
            if (busy || isOpen) return;
            busy = true;
            isOpen = true;

            gsap.set(overlay, {
                opacity: 1,
                clipPath: "inset(100% 0% 0% 0%)",
                pointerEvents: "auto"
            });

            var tl = gsap.timeline({
                onComplete: function () {
                    busy = false;
                }
            });

            tl.to(frame, {
                y: "-18vh",
                opacity: 0.6,
                duration: 0.9,
                ease: "power2.inOut"
            }, 0);

            tl.to(overlay, {
                clipPath: "inset(0% 0% 0% 0%)",
                duration: 0.9,
                ease: "power2.inOut"
            }, 0);
        }

        function closePanel() {
            if (busy || !isOpen) return;
            busy = true;
            isOpen = false;

            var tl = gsap.timeline({
                onComplete: function () {
                    busy = false;
                    gsap.set(overlay, {
                        opacity: 0,
                        pointerEvents: "none"
                    });
                }
            });

            tl.to(overlay, {
                clipPath: "inset(100% 0% 0% 0%)",
                duration: 0.8,
                ease: "power2.inOut"
            }, 0);

            tl.to(frame, {
                y: "0vh",
                opacity: 1,
                duration: 0.8,
                ease: "power2.inOut"
            }, 0);
        }

        trigger.addEventListener("click", function (e) {
            e.preventDefault();
            if (!isOpen) {
                openPanel();
            } else {
                closePanel();
            }
        });

        if (closeBtn) {
            closeBtn.addEventListener("click", function (e) {
                e.preventDefault();
                closePanel();
            });
        }

        function renumberNav() {
            try {
                var items = Array.prototype.slice.call(document.querySelectorAll('.landing-nav-main > li'));
                var n = 0;
                items.forEach(function (li) {
                    if (li && li.style && li.style.display === 'none') return;
                    var idx = li ? li.querySelector('.landing-nav-index') : null;
                    if (!idx) return;
                    n += 1;
                    idx.textContent = (n < 10 ? ('0' + n) : String(n));
                });
            } catch (e) { }
        }

        // Switch nav item #02 based on session:
        // - admin: ADMIN (Dashboard)
        // - user:  MY ACCOUNT
        // - guest: LOGIN
        try {
            var _cur = JSON.parse(sessionStorage.getItem('CurrentUser') || '{}');
            var _auth = document.getElementById('navAuthLink');
            if (_auth) {
                if (_cur && _cur.Role === 'admin') {
                    _auth.textContent = 'ADMIN';
                    _auth.setAttribute('href', '@Url.Action("Dashboard", "Admin")');
                } else if (_cur && _cur.Id) {
                    _auth.textContent = 'MY ACCOUNT';
                    _auth.setAttribute('href', '@Url.Action("MyAccount", "Account")');
                } else {
                    _auth.textContent = 'LOGIN';
                    _auth.setAttribute('href', '@Url.Action("LoginPage", "Account")');
                }
            }
            if (_cur && _cur.Role === 'admin') {
                var _al = document.getElementById('adminNavLink');
                if (_al) _al.style.display = 'none';
            }
        } catch (e) { }

        renumberNav();
    })();
})();
</script>
}
