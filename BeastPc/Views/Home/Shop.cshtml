@section scripts {
<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
<script>
/* ---------------- Load builds from DB and render grid ---------------- */
(function loadBuildsFromDb() {
    var grid = document.getElementById('buildsGrid');
    if (!grid) return;

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function tileHtml(b, idx) {
        var id = 'db-' + (b.Id || idx);
        var buildId = Number(b.Id || 0);
        var name = b.Name || 'SYSTEM';
        var desc = b.Description || '';
        var price = Number(b.Price || 0);
        var cpu = b.Cpu || '';
        var gpu = b.Gpu || '';
        var ram = b.Ram || '';
        var storage = b.Storage || '';
        var cooling = b.Cooling || '';
        var psu = b.Psu || '';
        var caseName = b.CaseName || '';
        var img = b.ImageUrl || '';
        var bg = img ? (' style="background-image:url(' + esc(img) + ')"') : '';
        var dataImg = img ? (' data-image="' + esc(img) + '"') : '';

        return (
            '<div class="products__item jsne-card"' +
            ' data-id="' + esc(id) + '"' +
            ' data-buildid="' + esc(buildId) + '"' +
            ' data-price="' + esc(price) + '"' +
            ' data-name="' + esc(name) + '"' +
            ' data-tagline="' + esc(desc) + '"' +
            ' data-cpu="' + esc(cpu) + '"' +
            ' data-gpu="' + esc(gpu) + '"' +
            ' data-ram="' + esc(ram) + '"' +
            ' data-storage="' + esc(storage) + '"' +
            ' data-cooling="' + esc(cooling || '—') + '"' +
            ' data-psu="' + esc(psu || '—') + '"' +
            ' data-case="' + esc(caseName || '—') + '"' +
            dataImg +
            '>' +
            '  <div class="products__images">' +
            '    <div class="products__main-image jsne-thumb"' + bg + '></div>' +
            '    <div class="products__gallery">' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '      <div class="products__gallery-item"' + bg + '></div>' +
            '    </div>' +
            '  </div>' +
            '  <div class="jsne-caption">' +
            '    <span class="jsne-name">' + esc(name) + '</span>' +
            '    <button type="button" class="jsne-plus products__cta" aria-label="Add to cart">+</button>' +
            '  </div>' +
            '</div>'
        );
    }

    var buildsUrl = '@Url.Action("GetBuilds", "BeastPc")';
    fetch(buildsUrl, { method: 'GET' })
        .then(function (r) {
            if (!r.ok) return r.text().then(function (t) { throw new Error('HTTP ' + r.status + ': ' + (t || '').slice(0, 180)); });
            return r.text().then(function (t) {
                try { return JSON.parse(t); }
                catch (e) { throw new Error('Non-JSON response: ' + (t || '').slice(0, 180)); }
            });
        })
        .then(function (j) {
            if (!j || !j.ok) throw new Error((j && j.error) ? j.error : 'Failed to load builds.');
            var builds = (j.builds || []).filter(function (b) { return b && (b.Active === true || b.Active === 1); });
            if (!builds.length) {
                grid.innerHTML =
                    '<div style="grid-column:1/-1;color:rgba(255,255,255,0.35);letter-spacing:0.14em;text-transform:uppercase;font-size:0.7rem;padding:2.4rem 0;text-align:center;">' +
                    'No builds yet. Add builds in the Admin Dashboard.' +
                    '</div>';
                document.dispatchEvent(new CustomEvent('beastpc:builds-rendered'));
                return;
            }
            grid.innerHTML = builds.map(tileHtml).join('');
            document.dispatchEvent(new CustomEvent('beastpc:builds-rendered'));
        })
        .catch(function (err) {
            grid.innerHTML =
                '<div style="grid-column:1/-1;color:rgba(255,120,120,0.9);letter-spacing:0.12em;text-transform:uppercase;font-size:0.7rem;padding:2.4rem 0;text-align:center;">' +
                'Could not load builds. ' + esc((err && err.message) ? err.message : 'Check API/DB connection.') +
                '</div>';
            document.dispatchEvent(new CustomEvent('beastpc:builds-rendered'));
        });
})();

/* ---------------- Cart (Codrops add-to-cart logic, vanilla-adapted) ---------------- */
(function () {
    var CART_STORAGE_KEY = 'beastpc_cart';
    var cartItems = [];
    try {
        var saved = sessionStorage.getItem(CART_STORAGE_KEY);
        if (saved) cartItems = JSON.parse(saved) || [];
    } catch (e) { cartItems = []; }

    var cartButton = document.querySelector('.cart-button');
    var cartButtonNumber = document.querySelector('.cart-button__number');
    var cartButtonBg = document.querySelector('.cart-button__number-bg');

    function persistCart() {
        try { sessionStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cartItems)); }
        catch (e) { /* ignore quota */ }
    }

    function updateCart() {
        var totalQty = 0;
        cartItems.forEach(function (it) { totalQty += Number(it.quantity) || 0; });
        cartButtonNumber.innerHTML = totalQty;
        persistCart();
    }

    function addItemToCart(el) {
        var id = el.dataset.id;
        var buildId = Number(el.dataset.buildid || 0);
        var price = el.dataset.price;
        var name = el.dataset.name;
        var thumbUrl = el.dataset.image || '';

        var index = -1;
        for (var i = 0; i < cartItems.length; i++) { if (cartItems[i].id === id) { index = i; break; } }

        if (index < 0) {
            var newItem = { id: id, buildId: buildId, price: price, name: name, thumbUrl: thumbUrl, quantity: 1 };
            cartItems.push(newItem);
        } else {
            cartItems[index].quantity += 1;
            if (buildId && !cartItems[index].buildId) cartItems[index].buildId = buildId;
            if (thumbUrl && !cartItems[index].thumbUrl) cartItems[index].thumbUrl = thumbUrl;
        }
        updateCart();
    }

    function cartButtonAnimationSetup() {
        if (!window.gsap) return;
        gsap.set([cartButtonNumber, cartButtonBg], { scale: 0 });
    }
    function cartButtonAnimationEnter() {
        if (!window.gsap) return;
        var tl = gsap.timeline();
        tl.to([cartButtonNumber, cartButtonBg], {
            scale: 1, stagger: 0.1, duration: 0.8, ease: 'elastic.out(1.3, 0.9)'
        }, 0);
    }

    cartButtonAnimationSetup();
    // Restore badge + animate it in if the cart is already populated from a previous page.
    if (cartItems.length > 0) {
        updateCart();
        if (window.gsap) cartButtonAnimationEnter();
    }

    // Allow the preview panel's "Add to cart" button to push items into the cart.
    window.addEventListener('rit:add-to-cart', function (e) {
        var item = e.detail && e.detail.item;
        if (!item) return;
        if (cartItems.length === 0 && window.gsap) cartButtonAnimationEnter();
        addItemToCart(item);
        renderCartMenu();
    });

    /* ----------- Osmo-style cart wipe panel ----------- */
    var cartNav = document.querySelector('.cart-nav');
    var cartMenu = cartNav ? cartNav.querySelector('.cart-menu') : null;
    var cartOverlay = cartNav ? cartNav.querySelector('.cart-overlay') : null;
    var cartBgPanels = cartNav ? cartNav.querySelectorAll('.bg-panel') : [];
    var cartMenuList = cartNav ? cartNav.querySelector('.cart-menu-list') : null;
    var cartMenuTotal = cartNav ? cartNav.querySelector('.cart-menu-total') : null;
    var cartToggles = document.querySelectorAll('[data-cart-toggle]');
    var cartNavFades = cartNav ? cartNav.querySelectorAll('[data-cart-fade]') : [];

    var cartIsAnimating = false;

    function formatPeso(val) { return '\u20B1' + Number(val || 0).toLocaleString(); }

    function renderCartMenu() {
        if (!cartMenuList) return;
        // Wipe existing rendered items (keep the "empty" li).
        var oldItems = cartMenuList.querySelectorAll('.cart-menu-item');
        oldItems.forEach(function (n) { n.remove(); });

        var emptyEl = cartMenuList.querySelector('[data-cart-empty]');
        if (cartItems.length === 0) {
            if (emptyEl) emptyEl.style.display = '';
        } else {
            if (emptyEl) emptyEl.style.display = 'none';

            cartItems.forEach(function (item) {
                var li = document.createElement('li');
                li.className = 'cart-menu-item';
                var thumb = document.createElement('div');
                thumb.className = 'cart-menu-item__thumb';
                if (item.thumbUrl) {
                    thumb.style.backgroundImage = 'url(' + item.thumbUrl + ')';
                    thumb.style.backgroundSize = 'cover';
                    thumb.style.backgroundPosition = 'center';
                }
                var body = document.createElement('div');
                body.className = 'cart-menu-item__body';
                body.innerHTML =
                    '<span class="cart-menu-item__name">' + item.name + '</span>' +
                    '<span class="cart-menu-item__meta">' + formatPeso(item.price) + ' each</span>';
                var qty = document.createElement('div');
                qty.className = 'cart-menu-item__qty';
                qty.innerHTML =
                    '<button type="button" data-minus="' + item.id + '" aria-label="Decrease">-</button>' +
                    '<span>' + item.quantity + '</span>' +
                    '<button type="button" data-plus="' + item.id + '" aria-label="Increase">+</button>' +
                    '<button type="button" class="cart-menu-item__remove" data-remove="' + item.id + '" aria-label="Remove">&times;</button>';
                li.appendChild(thumb);
                li.appendChild(body);
                li.appendChild(qty);
                cartMenuList.appendChild(li);
            });
        }

        var total = 0;
        cartItems.forEach(function (it) { total += Number(it.price) * it.quantity; });
        if (cartMenuTotal) cartMenuTotal.textContent = formatPeso(total);
    }

    function updateQty(id, delta) {
        for (var i = 0; i < cartItems.length; i++) {
            if (cartItems[i].id === id) {
                var nq = cartItems[i].quantity + delta;
                if (nq > 0) cartItems[i].quantity = nq;
                else { cartItems.splice(i, 1); }
                break;
            }
        }
        updateCart();
        renderCartMenu();
    }

    function removeItem(id) {
        for (var i = 0; i < cartItems.length; i++) {
            if (cartItems[i].id === id) { cartItems.splice(i, 1); break; }
        }
        updateCart();
        renderCartMenu();
    }

    if (cartMenuList) {
        cartMenuList.addEventListener('click', function (e) {
            var t = e.target;
            if (!t) return;
            if (t.dataset.plus)   return updateQty(t.dataset.plus, 1);
            if (t.dataset.minus)  return updateQty(t.dataset.minus, -1);
            if (t.dataset.remove) return removeItem(t.dataset.remove);
        });
    }

    /* Checkout button -> /Home/Checkout (cart flows via sessionStorage) */
    var checkoutBtn = document.querySelector('.cart-menu-checkout');
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', function () {
            if (cartItems.length === 0) return;
            persistCart();
            window.location.href = '@Url.Action("Checkout", "Home")';
        });
    }

    function openCartPanel() {
        if (!window.gsap || !cartNav || cartIsAnimating) return;
        if (cartNav.getAttribute('data-cart') === 'open') return;
        cartIsAnimating = true;
        cartNav.setAttribute('data-cart', 'open');

        renderCartMenu();

        var tl = gsap.timeline({
            defaults: { ease: 'power3.out', duration: 0.7 },
            onComplete: function () { cartIsAnimating = false; }
        });

        tl.set(cartNav, { display: 'block' })
          .set(cartMenu, { xPercent: 0 }, '<')
          .fromTo(cartOverlay, { autoAlpha: 0 }, { autoAlpha: 1 }, '<')
          .fromTo(cartBgPanels, { xPercent: 101 }, { xPercent: 0, stagger: 0.12, duration: 0.575 }, '<')
          .fromTo(cartNavFades, { autoAlpha: 0, yPercent: 40 }, { autoAlpha: 1, yPercent: 0, stagger: 0.04 }, '<+=0.35');
    }

    function closeCartPanel() {
        if (!window.gsap || !cartNav || cartIsAnimating) return;
        if (cartNav.getAttribute('data-cart') !== 'open') return;
        cartIsAnimating = true;
        cartNav.setAttribute('data-cart', 'closed');

        var tl = gsap.timeline({
            defaults: { ease: 'power3.inOut', duration: 0.55 },
            onComplete: function () {
                gsap.set(cartNav, { display: 'none' });
                cartIsAnimating = false;
            }
        });
        tl.to(cartOverlay, { autoAlpha: 0 })
          .to(cartMenu, { xPercent: 110 }, '<');
    }

    cartToggles.forEach(function (t) {
        t.addEventListener('click', function () {
            if (cartNav && cartNav.getAttribute('data-cart') === 'open') closeCartPanel();
            else openCartPanel();
        });
    });

    if (cartButton) {
        cartButton.addEventListener('click', function () { openCartPanel(); });
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && cartNav && cartNav.getAttribute('data-cart') === 'open') {
            closeCartPanel();
        }
    });

    /* ---------------- Products (fly-to-cart animation) ---------------- */
    var products = [];
    var ctas = [];
    var cartBtnCoords = { x: 0, y: 0 };

    function setCartButtonCoords() {
        var r = cartButton.getBoundingClientRect();
        cartBtnCoords = { x: r.x, y: r.y };
    }
    setCartButtonCoords();
    window.addEventListener('resize', setCartButtonCoords);
    window.addEventListener('scroll', setCartButtonCoords, { passive: true });

    function refreshProducts() {
        products = Array.prototype.slice.call(document.querySelectorAll('.products__item'));
        ctas = Array.prototype.slice.call(document.querySelectorAll('.products__cta'));
    }

    function bindCtas() {
        refreshProducts();
        ctas.forEach(function (cta) {
            if (cta.dataset && cta.dataset.cartBound === '1') return;
            if (cta.dataset) cta.dataset.cartBound = '1';
            cta.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation(); // clicking + should NOT open the preview transition
            var currentProduct = cta.closest('.products__item');
            if (!currentProduct) return;
            refreshProducts();
            var i = products.indexOf(currentProduct);
            if (!window.gsap) { addItemToCart(currentProduct); return; }

            var otherProducts = products.filter(function (p, j) { return j !== i; });
            var gallery = currentProduct.querySelector('.products__gallery');
            var currentGallery = Array.prototype.slice.call(currentProduct.querySelectorAll('.products__gallery-item'));
            var isTopRow = window.innerWidth > 768 && i < 3;

            gsap.set(gallery, { autoAlpha: 1 });
            gsap.set(currentGallery, { transformOrigin: isTopRow ? 'top right' : 'bottom left' });

            var rect = currentGallery[0].getBoundingClientRect();
            var y = rect.y, left = rect.left, right = rect.right, height = rect.height;

            var tl = gsap.timeline({
                onComplete: function () {
                    gsap.set(currentGallery, { scale: 1, autoAlpha: 1, y: 0, x: 0 });
                    gsap.set(gallery, { autoAlpha: 0 });
                }
            });
            tl.addLabel('start');

            tl.to(otherProducts, { scale: 0.8, autoAlpha: 0.05, duration: 0.6, stagger: 0.04, ease: 'power2.out' }, 'start');
            tl.to(currentProduct, { scale: 1.05, duration: 1, ease: 'power2.out' }, 'start+=0.7');

            tl.to(currentGallery, {
                keyframes: {
                    '40%': {
                        y: isTopRow ? height * 1.5 : -height * 1.5,
                        scale: isTopRow ? 0.8 : 0.5,
                        autoAlpha: 1
                    },
                    '100%': {
                        x: isTopRow ? cartBtnCoords.x - right : cartBtnCoords.x - left - 12,
                        y: isTopRow ? cartBtnCoords.y - y : cartBtnCoords.y - y - height + 25,
                        scale: 0,
                        autoAlpha: 0
                    }
                },
                stagger: { from: 'end', each: 0.04 },
                duration: 1.8,
                ease: 'power2.inOut'
            }, 'start');

            tl.add(function () {
                if (cartItems.length === 0) cartButtonAnimationEnter();
                addItemToCart(currentProduct);
            }, 'start+=0.6');

            tl.to([currentProduct].concat(otherProducts), {
                scale: 1, autoAlpha: 1, duration: 0.8, stagger: 0.03, ease: 'power2.out'
            }, 'start+=1.6');
            });
        });
    }

    bindCtas();
    document.addEventListener('beastpc:builds-rendered', function () { bindCtas(); renderCartMenu(); }, false);
})();

/* ---------------- Repeating Image Transition (click tile to preview) ---------------- */
(function setupRepeatingImageTransition() {
    if (!window.gsap) return;

    var panel = document.querySelector('.rit-panel');
    if (!panel) return;

    var panelImg = panel.querySelector('.rit-panel__img');
    var panelContent = panel.querySelector('.rit-panel__content');
    var panelTitle = panel.querySelector('.rit-panel__title');
    var panelDesc = panel.querySelector('.rit-panel__desc');
    var panelPrice = panel.querySelector('.rit-panel__price');
    var panelAdd = panel.querySelector('.rit-panel__add');
    var closeBtn = panel.querySelector('.rit-panel__close');
    var specFields = {
        cpu: panel.querySelector('[data-spec="cpu"]'),
        gpu: panel.querySelector('[data-spec="gpu"]'),
        ram: panel.querySelector('[data-spec="ram"]'),
        storage: panel.querySelector('[data-spec="storage"]'),
        cooling: panel.querySelector('[data-spec="cooling"]'),
        psu: panel.querySelector('[data-spec="psu"]'),
        'case': panel.querySelector('[data-spec="case"]')
    };

    var gridItems = [];
    var jsnePage = document.querySelector('.jsne-page');

    var isAnimating = false;
    var isOpen = false;
    var currentItem = null;

    function formatPeso(val) { return '\u20B1' + Number(val || 0).toLocaleString(); }

    var config = {
        clipPathDirection: 'top-bottom',
        steps: 7,
        stepDuration: 0.32,
        stepInterval: 0.05,
        moverPauseBeforeExit: 0.14,
        panelRevealEase: 'sine.inOut',
        moverEnterEase: 'sine.in',
        moverExitEase: 'sine',
        panelRevealDurationFactor: 2.1
    };

    function getClipPaths(direction) {
        switch (direction) {
            case 'bottom-top':
                return { from: 'inset(0% 0% 100% 0%)', reveal: 'inset(0% 0% 0% 0%)', hide: 'inset(100% 0% 0% 0%)' };
            case 'left-right':
                return { from: 'inset(0% 100% 0% 0%)', reveal: 'inset(0% 0% 0% 0%)', hide: 'inset(0% 0% 0% 100%)' };
            case 'right-left':
                return { from: 'inset(0% 0% 0% 100%)', reveal: 'inset(0% 0% 0% 0%)', hide: 'inset(0% 100% 0% 0%)' };
            case 'top-bottom':
            default:
                return { from: 'inset(100% 0% 0% 0%)', reveal: 'inset(0% 0% 0% 0%)', hide: 'inset(0% 0% 100% 0%)' };
        }
    }

    function getElementCenter(el) {
        var r = el.getBoundingClientRect();
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }

    function lerp(a, b, t) { return a + (b - a) * t; }

    function generateMotionPath(startRect, endRect, steps) {
        var path = [];
        var fullSteps = steps + 2;
        var startCenter = { x: startRect.left + startRect.width / 2, y: startRect.top + startRect.height / 2 };
        var endCenter = { x: endRect.left + endRect.width / 2, y: endRect.top + endRect.height / 2 };
        for (var i = 0; i < fullSteps; i++) {
            var t = i / (fullSteps - 1);
            var width = lerp(startRect.width, endRect.width, t);
            var height = lerp(startRect.height, endRect.height, t);
            var cx = lerp(startCenter.x, endCenter.x, t);
            var cy = lerp(startCenter.y, endCenter.y, t);
            path.push({ left: cx - width / 2, top: cy - height / 2, width: width, height: height });
        }
        return path.slice(1, -1);
    }

    function cleanupMovers(movers) {
        var delay = config.steps * config.stepInterval + (config.stepDuration * 2) + config.moverPauseBeforeExit + 0.15;
        gsap.delayedCall(delay, function () {
            movers.forEach(function (m) { if (m && m.remove) m.remove(); });
        });
    }

    function positionPanel(clickedItem) {
        var centerX = getElementCenter(clickedItem).x;
        var isLeftSide = centerX < (window.innerWidth / 2);
        if (isLeftSide) panel.classList.add('rit-panel--right');
        else panel.classList.remove('rit-panel--right');
    }

    function openFromItem(item) {
        if (isAnimating) return;
        isAnimating = true;
        currentItem = item;

        positionPanel(item);

        var imgEl = item.querySelector('.products__main-image');
        if (!imgEl) { isAnimating = false; return; }

        var bg = window.getComputedStyle(imgEl).backgroundImage;
        panelImg.style.backgroundImage = bg;
        panelTitle.textContent = item.dataset.name || 'SYSTEM';
        panelDesc.textContent = item.dataset.tagline || 'Specs and details coming soon.';
        panelPrice.textContent = formatPeso(item.dataset.price);

        Object.keys(specFields).forEach(function (key) {
            if (specFields[key]) {
                specFields[key].textContent = item.dataset[key] || '—';
            }
        });

        var clipPaths = getClipPaths(config.clipPathDirection);

        // Fade out the grid so the panel reads cleanly.
        gsap.to(gridItems, {
            opacity: 0,
            scale: function (i, el) { return el === item ? 1 : 0.9; },
            duration: 0.45,
            ease: 'sine.out',
            stagger: 0.02
        });

        gsap.set(panelContent, { opacity: 0, y: 18 });
        gsap.set(panel, { opacity: 1, pointerEvents: 'auto' });
        gsap.set(panelImg, { clipPath: clipPaths.hide });

        var startRect = imgEl.getBoundingClientRect();
        var endRect = panelImg.getBoundingClientRect();
        var path = generateMotionPath(startRect, endRect, config.steps);
        var movers = [];

        path.forEach(function (step, idx) {
            var mover = document.createElement('div');
            mover.className = 'rit-mover';
            mover.style.backgroundImage = bg;
            mover.style.left = step.left + 'px';
            mover.style.top = step.top + 'px';
            mover.style.width = step.width + 'px';
            mover.style.height = step.height + 'px';
            mover.style.zIndex = String(2000 + idx);
            mover.style.clipPath = clipPaths.from;
            document.body.appendChild(mover);
            movers.push(mover);

            var delay = idx * config.stepInterval;
            gsap.timeline({ delay: delay })
                .fromTo(mover, { opacity: 0.45, clipPath: clipPaths.hide }, {
                    opacity: 1,
                    clipPath: clipPaths.reveal,
                    duration: config.stepDuration,
                    ease: config.moverEnterEase
                })
                .to(mover, {
                    clipPath: clipPaths.from,
                    duration: config.stepDuration,
                    ease: config.moverExitEase
                }, '+=' + config.moverPauseBeforeExit);
        });

        cleanupMovers(movers);

        gsap.timeline({
            defaults: { duration: config.stepDuration * config.panelRevealDurationFactor, ease: config.panelRevealEase }
        })
            .to(panelImg, { clipPath: clipPaths.reveal, delay: config.steps * config.stepInterval }, 0)
            .to(panelContent, {
                opacity: 1,
                y: 0,
                duration: 0.9,
                ease: 'expo.out',
                delay: config.steps * config.stepInterval + 0.05,
                onComplete: function () {
                    isAnimating = false;
                    isOpen = true;
                }
            }, 0);
    }

    function closePanel() {
        if (isAnimating || !isOpen) return;
        isAnimating = true;

        gsap.timeline({
            onComplete: function () {
                gsap.set(panel, { opacity: 0, pointerEvents: 'none' });
                isAnimating = false;
                isOpen = false;
                currentItem = null;
            }
        })
            .to(panelContent, { opacity: 0, y: 10, duration: 0.25, ease: 'sine.inOut' }, 0)
            .to(panel, { opacity: 0, duration: 0.35, ease: 'sine.inOut' }, 0.05)
            .to(gridItems, {
                opacity: 1,
                scale: 1,
                duration: 0.45,
                ease: 'sine.out',
                stagger: 0.02
            }, 0.1);
    }

    // Panel "Add to cart" button — relays to the cart logic via a custom event.
    if (panelAdd) {
        panelAdd.addEventListener('click', function (e) {
            e.preventDefault();
            if (!currentItem) return;
            window.dispatchEvent(new CustomEvent('rit:add-to-cart', { detail: { item: currentItem } }));
        });
    }

    function refreshGridItems() {
        gridItems = Array.prototype.slice.call(document.querySelectorAll('.products__item'));
    }
    function bindTileClicks() {
        refreshGridItems();
        gridItems.forEach(function (tile) {
            if (tile.dataset && tile.dataset.ritBound === '1') return;
            if (tile.dataset) tile.dataset.ritBound = '1';
            tile.addEventListener('click', function () { openFromItem(tile); });
        });
    }

    // Hook clicks on tiles (not the + button).
    bindTileClicks();
    document.addEventListener('beastpc:builds-rendered', function () { bindTileClicks(); }, false);

    if (closeBtn) closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closePanel();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closePanel();
    });
})();

/* ---------------- Hero nav overlay transition (same as Index) ---------------- */
(function setupNavOverlay() {
    var trigger = document.querySelector('.landing-menu');
    var overlay = document.querySelector('.landing-transition-overlay');
    var closeBtn = document.querySelector('.landing-nav-close');
    if (!trigger || !overlay || !window.gsap) return;

    var isOpen = false;
    var busy = false;

    function openPanel() {
        if (busy || isOpen) return;
        busy = true; isOpen = true;
        gsap.set(overlay, { opacity: 1, clipPath: 'inset(100% 0% 0% 0%)', pointerEvents: 'auto' });
        var tl = gsap.timeline({ onComplete: function () { busy = false; } });
        tl.to(overlay, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'power2.inOut' }, 0);
    }
    function closePanel() {
        if (busy || !isOpen) return;
        busy = true; isOpen = false;
        var tl = gsap.timeline({
            onComplete: function () { busy = false; gsap.set(overlay, { opacity: 0, pointerEvents: 'none' }); }
        });
        tl.to(overlay, { clipPath: 'inset(100% 0% 0% 0%)', duration: 0.8, ease: 'power2.inOut' }, 0);
    }

    trigger.addEventListener('click', function (e) { e.preventDefault(); isOpen ? closePanel() : openPanel(); });
    if (closeBtn) closeBtn.addEventListener('click', function (e) { e.preventDefault(); closePanel(); });

    function renumberNav() {
        try {
            var items = Array.prototype.slice.call(document.querySelectorAll('.landing-nav-main > li'));
            var n = 0;
            items.forEach(function (li) {
                if (li && li.style && li.style.display === 'none') return;
                var idx = li ? li.querySelector('.landing-nav-index') : null;
                if (!idx) return;
                n += 1;
                idx.textContent = (n < 10 ? ('0' + n) : String(n));
            });
        } catch (e) { }
    }

    // Switch nav item #02 based on session:
    // - admin: ADMIN (Dashboard)
    // - user:  MY ACCOUNT
    // - guest: LOGIN
    try {
        var _cur = JSON.parse(sessionStorage.getItem('CurrentUser') || '{}');
        var _auth = document.getElementById('navAuthLink');
        if (_auth) {
            if (_cur && _cur.Role === 'admin') {
                _auth.textContent = 'ADMIN';
                _auth.setAttribute('href', '@Url.Action("Dashboard", "Admin")');
            } else if (_cur && _cur.Id) {
                _auth.textContent = 'MY ACCOUNT';
                _auth.setAttribute('href', '@Url.Action("MyAccount", "Account")');
            } else {
                _auth.textContent = 'LOGIN';
                _auth.setAttribute('href', '@Url.Action("LoginPage", "Account")');
            }
        }
        if (_cur && _cur.Role === 'admin') {
            var _al = document.getElementById('adminNavLink');
            if (_al) _al.style.display = 'none';
        }
    } catch (e) { }

    renumberNav();
})();
</script>
