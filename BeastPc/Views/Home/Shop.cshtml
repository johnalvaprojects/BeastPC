@{
    ViewBag.Title = "Shop";
    Layout = "~/Views/Shared/_HomeFooterLayout.cshtml";
}

@* ================== FIXED UI: HAMBURGER MENU + CART BUTTON ================== *@
<div class="landing-menu-wrap">
    <span class="landing-menu-label">OPEN</span>
    <button type="button" class="landing-menu" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
    </button>
</div>

<div class="cart-button" aria-label="Cart">
    <div class="cart-button__label-wrap">
        <img class="cart-button__icon" src="@Url.Content("~/Content/images/shopping-cart.png")" alt="Cart" />
    </div>
    <div class="cart-button__number-wrap">
        <span class="cart-button__number-bg"></span>
        <span class="cart-button__number">0</span>
    </div>
</div>

@* ================== NAV OVERLAY PANEL (same as homepage) ================== *@
<div class="landing-transition-overlay">
    <div class="landing-nav-panel">
        <div class="landing-nav-left">
            <video class="landing-nav-media" autoplay muted loop playsinline>
                <source src="@Url.Content("~/Content/video/navbar/BlackTopoDesktop.mp4")" type="video/mp4" />
            </video>
        </div>
        <div class="landing-nav-right">
            <div class="landing-nav-header">
                <span class="landing-nav-title"></span>
                <div class="landing-nav-header-right">
                    <button type="button" class="landing-nav-close" aria-label="Close navigation">
                        <span></span>
                        <span></span>
                    </button>
                    <span class="landing-nav-close-label">CLOSE</span>
                </div>
            </div>
            <ol class="landing-nav-main">
                <li>
                    <span class="landing-nav-index">01</span>
                    <a class="landing-nav-label" href="@Url.Action("Index", "Home")">HOME</a>
                    <span class="landing-nav-plus">+</span>
                </li>
                <li>
                    <span class="landing-nav-index">02</span>
                    <a class="landing-nav-label" id="navAuthLink" href="@Url.Action("LoginPage", "Account")">LOGIN</a>
                    <span class="landing-nav-plus">+</span>
                </li>
                <li>
                    <span class="landing-nav-index">03</span>
                    <a class="landing-nav-label" href="@Url.Action("Shop", "Home")">SHOP</a>
                    <span class="landing-nav-plus">+</span>
                </li>
                <li>
                    <span class="landing-nav-index">04</span>
                    <a class="landing-nav-label" href="@Url.Action("About", "Home")">ABOUT</a>
                    <span class="landing-nav-plus">+</span>
                </li>
                <li>
                    <span class="landing-nav-index">05</span>
                    <a class="landing-nav-label" href="@Url.Action("Contact", "Home")">CONTACT</a>
                    <span class="landing-nav-plus">+</span>
                </li>
                <li id="adminNavLink" style="display:none">
                    <span class="landing-nav-index">06</span>
                    <a class="landing-nav-label" href="@Url.Action("Dashboard", "Admin")">ADMIN</a>
                    <span class="landing-nav-plus">+</span>
                </li>
            </ol>
            <div class="landing-nav-meta">
                <div class="landing-nav-column">
                    <span class="landing-nav-footer-title">FOLLOW</span>
                    <span class="landing-nav-footer-item">Instagram</span>
                    <span class="landing-nav-footer-item">YouTube</span>
                </div>
                <div class="landing-nav-column">
                    <span class="landing-nav-footer-title">CONTACT</span>
                    <span class="landing-nav-footer-item">info@@beastpc.local</span>
                </div>
            </div>
            <div class="landing-nav-footer">
                <span class="landing-nav-footer-brand">BEASTPC</span>
            </div>
        </div>
    </div>
</div>

@* ================== BUILDS GRID (Janis Sne style + product animation hooks) ================== *@
<section class="jsne-page">
    <div class="products__list jsne-grid" id="buildsGrid">
        <div style="grid-column:1/-1;color:rgba(255,255,255,0.45);letter-spacing:0.14em;text-transform:uppercase;font-size:0.7rem;padding:2.4rem 0;text-align:center;">
            Loading catalog…
        </div>
    </div>
</section>

@* ================== CART WIPE PANEL (Osmo-style) ================== *@
<div data-cart="closed" class="cart-nav">
    <div data-cart-toggle class="cart-overlay"></div>
    <aside class="cart-menu">
        <div class="cart-menu-bg">
            <div class="bg-panel first"></div>
            <div class="bg-panel second"></div>
            <div class="bg-panel third"></div>
        </div>
        <div class="cart-menu-inner">
            <div class="cart-menu-head">
                <span class="cart-menu-eyebrow" data-cart-fade>YOUR CART</span>
                <button type="button" class="cart-menu-close" data-cart-toggle aria-label="Close cart">
                    <span></span><span></span>
                </button>
            </div>
            <ul class="cart-menu-list">
                <li class="cart-menu-empty" data-cart-empty>
                    <p class="cart-menu-empty-title">Cart is empty</p>
                    <p class="cart-menu-empty-sub" data-cart-fade>
                        Click the <span class="cart-menu-plus">+</span> on any system to add it here.
                    </p>
                </li>
            </ul>
            <div class="cart-menu-foot" data-cart-foot>
                <div class="cart-menu-total-row">
                    <span data-cart-fade>Total</span>
                    <span class="cart-menu-total" data-cart-fade>&#8369;0</span>
                </div>
                <button type="button" class="cart-menu-checkout" data-cart-fade>Checkout</button>
            </div>
        </div>
    </aside>
</div>

@* ================== REPEATING IMAGE TRANSITION PANEL (Codrops-style) ================== *@
<figure class="rit-panel" role="dialog" aria-modal="true" aria-label="System preview">
    <div class="rit-panel__img"></div>
    <figcaption class="rit-panel__content">
        <div class="rit-panel__intro">
            <span class="rit-panel__eyebrow">BEASTPC / READY-TO-SHIP</span>
            <h3 class="rit-panel__title">SYSTEM</h3>
            <p class="rit-panel__desc">Preview</p>
        </div>

        <dl class="rit-panel__specs">
            <div class="rit-spec" data-spec-key="cpu"><dt>CPU</dt><dd data-spec="cpu">—</dd></div>
            <div class="rit-spec" data-spec-key="gpu"><dt>GPU</dt><dd data-spec="gpu">—</dd></div>
            <div class="rit-spec" data-spec-key="ram"><dt>RAM</dt><dd data-spec="ram">—</dd></div>
            <div class="rit-spec" data-spec-key="storage"><dt>Storage</dt><dd data-spec="storage">—</dd></div>
            <div class="rit-spec" data-spec-key="cooling"><dt>Cooling</dt><dd data-spec="cooling">—</dd></div>
            <div class="rit-spec" data-spec-key="psu"><dt>PSU</dt><dd data-spec="psu">—</dd></div>
            <div class="rit-spec" data-spec-key="case"><dt>Case</dt><dd data-spec="case">—</dd></div>
        </dl>

        <div class="rit-panel__bottom">
            <div class="rit-panel__footer">
                <span class="rit-panel__price">&#8369;0</span>
                <div class="rit-panel__actions">
                    <button type="button" class="rit-panel__add" data-action="add">Add to cart</button>
                    <button type="button" class="rit-panel__close" aria-label="Close preview">Close</button>
                </div>
            </div>
            <div class="rit-panel__trust" aria-label="Shipping and warranty">
                <div class="rit-panel__trust-row">
                    <span class="rit-panel__trust-mark" aria-hidden="true">✓</span>
                    <span><strong>1-year limited warranty</strong> on covered parts and labor. Email support for setup questions.</span>
                </div>
                <div class="rit-panel__trust-row">
                    <span class="rit-panel__trust-mark" aria-hidden="true">✓</span>
                    <span><strong>Secure packing &amp; insured shipping</strong> within the Philippines. Tracking sent when your order ships.</span>
                </div>
            </div>
        </div>
    </figcaption>
</figure>

@section styles {
<style>
    /* ========== Fonts (match homepage) ========== */
    @@font-face {
        font-family: 'OrithDisplay';
        src: url('@Url.Content("~/Content/fonts/orith-font/orithdisplay-regular.otf")') format("opentype");
        font-weight: 400;
        font-style: normal;
    }
    @@font-face {
        font-family: 'Inter Display';
        src: url('@Url.Content("~/Content/fonts/Inter-4.1/extras/otf/InterDisplay-Medium.otf")') format("opentype");
        font-weight: 500;
        font-style: normal;
    }
    @@font-face {
        font-family: 'Bebas Neue';
        src: url('@Url.Content("~/Content/fonts/bebas_neue/BebasNeue-Regular.otf")') format("opentype");
        font-weight: 400;
        font-style: normal;
    }

    /* ========== Nav menu (hamburger trigger) ========== */
    .landing-menu-wrap {
        position: fixed;
        top: 3.5%;
        right: 3%;
        z-index: 140;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.45rem;
    }
    .landing-menu-label {
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.9);
        opacity: 0;
        transform: translateX(-6px);
        transition: opacity 0.22s ease-out, transform 0.22s ease-out;
        font-family: 'Inter Display', system-ui, sans-serif;
    }
    .landing-menu-wrap:hover .landing-menu-label {
        opacity: 1;
        transform: translateX(0);
    }
    .landing-menu {
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        background: transparent;
        border: none;
        cursor: pointer;
        color: rgba(255,255,255,0.9);
    }
    .landing-menu-wrap:hover .landing-menu { color: #fff; }
    .landing-menu span {
        display: block;
        width: 1.5rem;
        height: 2px;
        background: currentColor;
        border-radius: 1px;
    }

    /* ========== Nav overlay panel ========== */
    .landing-transition-overlay {
        position: fixed;
        inset: 0;
        background: #000;
        opacity: 0;
        pointer-events: none;
        clip-path: inset(100% 0% 0% 0%);
        z-index: 150;
        transition: none;
    }
    .landing-nav-panel {
        position: absolute;
        inset: 1.2rem 1.4rem;
        border-radius: 38px;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 0.45fr) minmax(0, 0.55fr);
        color: #111111;
        font-family: 'Inter Display', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: linear-gradient(135deg, rgba(16,16,16,0.96), rgba(5,5,5,0.98));
        box-shadow: 0 28px 80px rgba(0,0,0,0.9);
    }
    .landing-nav-left {
        position: relative;
        padding: 0;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
    }
    .landing-nav-media {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .landing-nav-right {
        position: relative;
        padding: 3.4rem 2.8rem 2.4rem 1.8rem;
        overflow: hidden;
        background: #ffffff;
    }
    .landing-nav-header {
        position: absolute;
        top: 1.4rem;
        left: 1.8rem;
        right: 2.8rem;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 0.62rem;
    }
    .landing-nav-title { display: none; }
    .landing-nav-header-right {
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        gap: 0.45rem;
    }
    .landing-nav-close {
        position: relative;
        width: 1.6rem;
        height: 1.6rem;
        border: none;
        background: transparent;
        cursor: pointer;
    }
    .landing-nav-close span {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1rem;
        height: 1px;
        background: rgba(0,0,0,0.75);
        transform-origin: center;
        transition: transform 0.22s ease-out;
    }
    .landing-nav-close span:first-child { transform: translate(-50%, -50%) rotate(45deg); }
    .landing-nav-close span:last-child  { transform: translate(-50%, -50%) rotate(-45deg); }
    .landing-nav-close-label {
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #111111;
        opacity: 0;
        transform: translateX(6px);
        transition: opacity 0.22s ease-out, transform 0.22s ease-out;
    }
    .landing-nav-header-right:hover .landing-nav-close-label { opacity: 1; transform: translateX(0); }
    .landing-nav-header-right:hover .landing-nav-close span:first-child { transform: translate(-50%, -50%) rotate(0deg); }
    .landing-nav-header-right:hover .landing-nav-close span:last-child  { transform: translate(-50%, -50%) rotate(90deg); }

    .landing-nav-main {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        position: absolute;
        left: 1.8rem;
        right: 2.8rem;
        top: 40%;
        transform: translateY(-40%);
    }
    .landing-nav-main li {
        display: grid;
        grid-template-columns: 3.2rem auto 1.4rem;
        align-items: center;
        padding: 0.45rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        cursor: pointer;
    }
    .landing-nav-index {
        font-size: 1.36rem;
        letter-spacing: 0.16em;
        color: #111111;
    }
    .landing-nav-label {
        font-size: 1.56rem;
        letter-spacing: 0.09em;
        color: #111111;
        transform-origin: left center;
        transition: transform 0.25s ease-out;
        text-decoration: none;
    }
    .landing-nav-plus {
        justify-self: end;
        font-size: 0.85rem;
        opacity: 1;
        color: #111111;
    }
    .landing-nav-main li:hover .landing-nav-label { transform: scale(1.08); }
    .landing-nav-meta {
        position: absolute;
        left: 1.8rem;
        right: 2.8rem;
        top: 61%;
        display: flex;
        gap: 3rem;
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .landing-nav-column {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .landing-nav-footer-title { color: #111111; }
    .landing-nav-footer-item  { color: #111111; }
    .landing-nav-footer {
        position: absolute;
        left: 1.8rem;
        right: 2.8rem;
        bottom: 1.8rem;
        display: flex;
        justify-content: flex-start;
        align-items: flex-end;
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .landing-nav-footer-brand {
        font-family: 'OrithDisplay', cursive;
        font-size: 2.4rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #111111;
        padding-top: 0.4rem;
        padding-bottom: 0.4rem;
    }

    /* ========== Shared gradient thumbnails ========== */
    .jsne-page {
        min-height: 100vh;
        background: #000;
        color: #fff;
        padding: 5.5rem 1.2rem 3rem 1.2rem;
    }
    .jsne-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.6rem;
        max-width: 1600px;
        margin: 0 auto;
    }
    .jsne-card {
        display: block;
        position: relative;
    }
    .products__images {
        position: relative;
    }
    .jsne-thumb,
    .products__main-image {
        aspect-ratio: 1 / 1;
        width: 100%;
        background-color: #0b0b0b;
        background-size: cover;
        background-position: center;
        filter: grayscale(0.06) contrast(1.02);
        transition: transform 0.5s ease, filter 0.5s ease;
    }
    .jsne-card:hover .products__main-image {
        transform: scale(1.015);
        filter: grayscale(0) contrast(1.05);
    }
    .jsne-thumb-1 {
        background-image:
            radial-gradient(circle at 30% 30%, rgba(255,255,255,0.18), transparent 55%),
            radial-gradient(circle at 70% 70%, rgba(255,59,59,0.15), transparent 55%),
            linear-gradient(135deg, #1a1a1a, #050505);
    }
    .jsne-thumb-2 {
        background-image:
            radial-gradient(circle at 60% 20%, rgba(0,229,255,0.12), transparent 55%),
            linear-gradient(135deg, #0f0f12, #05060a);
    }
    .jsne-thumb-3 {
        background-image:
            radial-gradient(circle at 40% 60%, rgba(127,93,255,0.14), transparent 55%),
            linear-gradient(135deg, #111012, #070608);
    }
    .jsne-thumb-4 {
        background-image:
            radial-gradient(circle at 20% 80%, rgba(255,159,28,0.14), transparent 55%),
            linear-gradient(135deg, #141212, #080606);
    }
    .jsne-thumb-5 {
        background-image:
            radial-gradient(circle at 70% 40%, rgba(0,255,170,0.10), transparent 55%),
            linear-gradient(135deg, #0c1210, #050707);
    }
    .jsne-thumb-6 {
        background-image:
            radial-gradient(circle at 30% 70%, rgba(255,200,0,0.10), transparent 55%),
            linear-gradient(135deg, #161310, #070605);
    }

    /* ========== Gallery (hidden replicas that fly to cart) ========== */
    .products__gallery {
        position: absolute;
        inset: 0;
        pointer-events: none;
        visibility: hidden;
    }
    .products__gallery-item {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        border-radius: 6px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        will-change: transform, opacity;
    }

    /* ========== Caption row under each tile ========== */
    .jsne-caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 0.25rem 1.6rem 0.25rem;
        font-family: 'Inter Display', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-size: 0.72rem;
    }
    .jsne-name { color: #ffffff; }
    .jsne-plus {
        color: #ffffff;
        font-size: 1rem;
        line-height: 1;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.25rem 0.35rem;
        transition: transform 0.3s ease-out;
    }
    .jsne-card:hover .jsne-plus { transform: rotate(90deg); }

    @@media (max-width: 1024px) { .jsne-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 640px)  { .jsne-grid { grid-template-columns: 1fr; } }

    /* ========== Cart button ========== */
    .cart-button {
        position: fixed;
        top: 3.5%;
        right: 8.5%;
        z-index: 120;
        height: 2.5rem; /* match .landing-menu so both icons share a vertical center */
        display: flex;
        align-items: center;
        gap: 0.55rem;
        cursor: pointer;
        color: #fff;
        font-family: 'Inter Display', system-ui, sans-serif;
        font-size: 0.66rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        user-select: none;
    }
    .cart-button__label-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .cart-button__icon {
        display: block;
        width: 1.55rem;
        height: 1.55rem;
        object-fit: contain;
        filter: brightness(0) invert(1);
        transition: transform 0.35s ease;
    }
    .cart-button:hover .cart-button__icon { transform: scale(1.12) rotate(-4deg); }
    .cart-button__number-wrap {
        position: relative;
        width: 1.5rem;
        height: 1.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .cart-button__number-bg {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #ffffff;
    }
    .cart-button__number {
        position: relative;
        z-index: 2;
        color: #000;
        font-family: 'Inter Display', system-ui, sans-serif;
        font-weight: 600;
        font-size: 0.68rem;
        letter-spacing: 0;
    }

    /* ================= Osmo-style cart wipe panel ================= */
    .cart-nav {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100vh;
        z-index: 145; /* below repeat-image-panel (160), above nav (140) */
        display: none;
        overflow: hidden; /* prevents xPercent: 101 from creating a scrollbar */
    }
    .cart-nav[data-cart="open"] { display: block; }
    .cart-overlay {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: rgba(0,0,0,0.55);
        cursor: pointer;
    }
    .cart-menu {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: min(30em, 92vw);
        overflow: hidden; /* contains the bg-panels wipe */
    }
    .cart-menu-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .bg-panel {
        position: absolute;
        inset: 0;
        border-top-left-radius: 1.25em;
        border-bottom-left-radius: 1.25em;
        background: #0b0b0b;
    }
    .bg-panel.first  { background: #1a0a0a; } /* red-ish accent */
    .bg-panel.second { background: #141414; } /* mid-tone */
    .bg-panel.third  { background: #0b0b0b; } /* final surface */

    .cart-menu-inner {
        position: relative;
        z-index: 1;
        height: 100%;
        padding: 2.6rem 1.6rem 1.6rem 1.6rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: #fff;
        font-family: 'Inter Display', system-ui, sans-serif;
    }
    .cart-menu-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .cart-menu-eyebrow {
        font-size: 0.66rem;
        letter-spacing: 0.3em;
        color: rgba(255,255,255,0.55);
        text-transform: uppercase;
    }
    .cart-menu-close {
        position: relative;
        width: 1.8rem;
        height: 1.8rem;
        background: transparent;
        border: none;
        cursor: pointer;
    }
    .cart-menu-close span {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.1rem;
        height: 1px;
        background: rgba(255,255,255,0.8);
        transform-origin: center;
    }
    .cart-menu-close span:first-child { transform: translate(-50%, -50%) rotate(45deg); }
    .cart-menu-close span:last-child  { transform: translate(-50%, -50%) rotate(-45deg); }

    .cart-menu-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        overflow-y: auto;
        overflow-x: hidden;
        flex: 1 1 auto;
        min-height: 0;
        padding-right: 0.2rem;
    }
    .cart-menu-empty {
